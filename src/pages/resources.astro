---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Resources" description="The best books, apps, and tools for meditation, law of attraction, and mindset growth.">

  <div class="page-header">
    <h1>Resources</h1>
    <p>Curated books, apps, and tools that have genuinely made a difference.</p>
  </div>

  <section class="section" style="padding-top:0;">

    <!-- Books -->
    <div class="section-header">
      <h2 class="section-title">📚 Essential Books</h2>
    </div>
    <div class="resources-grid" style="margin-bottom:3rem;">

      <a href="https://amzn.to/YOUR-LINK" target="_blank" rel="noopener noreferrer" class="resource-card">
        <div class="resource-icon">📖</div>
        <h3>The Power of Now</h3>
        <p>Eckhart Tolle's masterpiece on present-moment awareness. Arguably the most transformative book on consciousness ever written.</p>
        <span class="btn btn-ghost" style="font-size:0.8rem;padding:0.5rem 1rem;">View on Amazon →</span>
      </a>

      <a href="https://amzn.to/YOUR-LINK" target="_blank" rel="noopener noreferrer" class="resource-card">
        <div class="resource-icon">📖</div>
        <h3>Think and Grow Rich</h3>
        <p>Napoleon Hill's timeless study of the mindset behind success. The foundation of modern law of attraction thinking.</p>
        <span class="btn btn-ghost" style="font-size:0.8rem;padding:0.5rem 1rem;">View on Amazon →</span>
      </a>

      <a href="https://amzn.to/YOUR-LINK" target="_blank" rel="noopener noreferrer" class="resource-card">
        <div class="resource-icon">📖</div>
        <h3>The Secret</h3>
        <p>Rhonda Byrne's introduction to law of attraction that changed millions of lives. A great starting point.</p>
        <span class="btn btn-ghost" style="font-size:0.8rem;padding:0.5rem 1rem;">View on Amazon →</span>
      </a>

      <a href="https://amzn.to/YOUR-LINK" target="_blank" rel="noopener noreferrer" class="resource-card">
        <div class="resource-icon">📖</div>
        <h3>Meditations - Marcus Aurelius</h3>
        <p>The greatest stoic text ever written. Personal journal of a Roman Emperor on discipline, perception, and inner peace.</p>
        <span class="btn btn-ghost" style="font-size:0.8rem;padding:0.5rem 1rem;">View on Amazon →</span>
      </a>

      <a href="https://amzn.to/YOUR-LINK" target="_blank" rel="noopener noreferrer" class="resource-card">
        <div class="resource-icon">📖</div>
        <h3>Breaking the Habit of Being Yourself</h3>
        <p>Dr. Joe Dispenza blends neuroscience with quantum physics to explain how to rewire your mind for a new reality.</p>
        <span class="btn btn-ghost" style="font-size:0.8rem;padding:0.5rem 1rem;">View on Amazon →</span>
      </a>

      <a href="https://amzn.to/YOUR-LINK" target="_blank" rel="noopener noreferrer" class="resource-card">
        <div class="resource-icon">📖</div>
        <h3>You Are the Placebo</h3>
        <p>Scientific evidence that your thoughts and beliefs literally change your biology. Mind-expanding and backed by research.</p>
        <span class="btn btn-ghost" style="font-size:0.8rem;padding:0.5rem 1rem;">View on Amazon →</span>
      </a>

    </div>

    <!-- Apps -->
    <div class="section-header">
      <h2 class="section-title">📱 Meditation Apps</h2>
    </div>
    <div class="resources-grid" style="margin-bottom:3rem;">

      <a href="https://www.calm.com" target="_blank" rel="noopener noreferrer" class="resource-card">
        <div class="resource-icon">🧘</div>
        <h3>Calm</h3>
        <p>The gold standard for meditation apps. Sleep stories, guided meditations, and breathing exercises. Best for beginners and daily practice.</p>
        <span class="btn btn-ghost" style="font-size:0.8rem;padding:0.5rem 1rem;">Try Calm →</span>
      </a>

      <a href="https://www.headspace.com" target="_blank" rel="noopener noreferrer" class="resource-card">
        <div class="resource-icon">🌿</div>
        <h3>Headspace</h3>
        <p>Science-backed meditation with structured courses. Great for building a consistent meditation habit from scratch.</p>
        <span class="btn btn-ghost" style="font-size:0.8rem;padding:0.5rem 1rem;">Try Headspace →</span>
      </a>

      <a href="https://insighttimer.com" target="_blank" rel="noopener noreferrer" class="resource-card">
        <div class="resource-icon">⏱</div>
        <h3>Insight Timer</h3>
        <p>The largest free meditation library in the world. Thousands of guided sessions from teachers across every tradition.</p>
        <span class="btn btn-ghost" style="font-size:0.8rem;padding:0.5rem 1rem;">Try Free →</span>
      </a>

    </div>

    <!-- Journals -->
    <div class="section-header">
      <h2 class="section-title">📓 Journals & Tools</h2>
    </div>
    <div class="resources-grid">

      <a href="https://amzn.to/YOUR-LINK" target="_blank" rel="noopener noreferrer" class="resource-card">
        <div class="resource-icon">✍️</div>
        <h3>The Five Minute Journal</h3>
        <p>The simplest daily gratitude and intention-setting practice. Used by thousands of high performers worldwide.</p>
        <span class="btn btn-ghost" style="font-size:0.8rem;padding:0.5rem 1rem;">View on Amazon →</span>
      </a>

      <a href="https://amzn.to/YOUR-LINK" target="_blank" rel="noopener noreferrer" class="resource-card">
        <div class="resource-icon">✨</div>
        <h3>Manifestation Journal</h3>
        <p>A structured journal for scripting, visualisation, and setting intentions. Great for law of attraction practice.</p>
        <span class="btn btn-ghost" style="font-size:0.8rem;padding:0.5rem 1rem;">View on Amazon →</span>
      </a>

    </div>

  </section>

  <div style="background:var(--bg-alt);border-top:1px solid var(--border);padding:1.5rem 2rem;text-align:center;">
    <p style="font-size:0.8rem;color:var(--text-light);">Some links on this page are affiliate links. If you purchase through them, I earn a small commission at no extra cost to you. I only recommend things I genuinely believe in.</p>
  </div>

</BaseLayout>
