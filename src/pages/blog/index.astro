---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['All', ...new Set(allPosts.map(p => p.data.category || 'Mindset'))];
---

<BaseLayout title="Blog" description="Articles on mindset, meditation, law of attraction, and conscious living.">

  <div class="page-header">
    <h1>The Blog</h1>
    <p>Thoughts on mind, manifestation, and the life you're creating.</p>
  </div>

  <section class="section" style="padding-top:0;">

    <!-- Category Filter -->
    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-bottom:2.5rem;">
      {categories.map(cat => (
        <button
          class="category-btn"
          data-category={cat}
          style="padding:0.4rem 1.1rem;border-radius:100px;border:1.5px solid var(--border);background:transparent;font-family:var(--font-sans);font-size:0.8rem;font-weight:500;color:var(--text-muted);cursor:pointer;transition:all 0.2s;"
          onclick={`filterPosts('${cat}')`}
        >
          {cat}
        </button>
      ))}
    </div>

    <div class="blog-grid" id="posts-grid">
      {sortedPosts.map(post => (
        <a href={`/blog/${post.slug}`} class="blog-card" data-category={post.data.category || 'Mindset'}>
          <div class="blog-card-tag">{post.data.category || 'Mindset'}</div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <div class="blog-card-meta">
            <span>🗓 {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
          </div>
        </a>
      ))}
    </div>

  </section>

</BaseLayout>

<script>
function filterPosts(category: string) {
  const cards = document.querySelectorAll('.blog-card[data-category]') as NodeListOf<HTMLElement>;
  const btns = document.querySelectorAll('.category-btn') as NodeListOf<HTMLElement>;

  btns.forEach(btn => {
    const isActive = btn.dataset.category === category;
    btn.style.background = isActive ? 'var(--accent)' : 'transparent';
    btn.style.color = isActive ? 'white' : 'var(--text-muted)';
    btn.style.borderColor = isActive ? 'var(--accent)' : 'var(--border)';
  });

  cards.forEach(card => {
    if (category === 'All' || card.dataset.category === category) {
      card.style.display = 'flex';
    } else {
      card.style.display = 'none';
    }
  });
}

// Set All as active on load
document.addEventListener('DOMContentLoaded', () => {
  const firstBtn = document.querySelector('.category-btn') as HTMLElement;
  if (firstBtn) {
    firstBtn.style.background = 'var(--accent)';
    firstBtn.style.color = 'white';
    firstBtn.style.borderColor = 'var(--accent)';
  }
});
</script>
