---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category?: string;
  readTime?: string;
  seoTitle?: string;
  seoDescription?: string;
  focusKeyword?: string;
  ogImage?: string;
  canonicalUrl?: string;
  author?: string;
}

const {
  title,
  description,
  pubDate,
  category = 'Mindset',
  readTime = '5 min read',
  seoTitle,
  seoDescription,
  focusKeyword,
  ogImage,
  canonicalUrl,
  author = "It's All About Mind",
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const isoDate = pubDate.toISOString();
const resolvedTitle = seoTitle || title;
const resolvedDescription = seoDescription || description;
const resolvedCanonical = canonicalUrl || Astro.url.href;
const siteUrl = 'https://itsallaboutmind.com';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": resolvedTitle,
  "description": resolvedDescription,
  "author": {
    "@type": "Person",
    "name": author,
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "It's All About Mind",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    }
  },
  "datePublished": isoDate,
  "dateModified": isoDate,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": resolvedCanonical
  },
  "keywords": focusKeyword,
  "articleSection": category,
  ...(ogImage ? { "image": ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}` } : {}),
};
---

<BaseLayout
  title={resolvedTitle}
  description={resolvedDescription}
  image={ogImage}
  canonicalUrl={resolvedCanonical}
>
  <Fragment slot="head">
    <!-- Canonical -->
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Robots - allow full snippets for AI/LLM crawlers -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    {focusKeyword && <meta name="keywords" content={focusKeyword} />}
    <meta name="author" content={author} />

    <!-- Open Graph -->
    <meta property="article:published_time" content={isoDate} />
    <meta property="article:section" content={category} />
    {focusKeyword && <meta property="article:tag" content={focusKeyword} />}

    <!-- JSON-LD Article Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article>
    <div class="post-hero">
      <a href="/blog" style="display:inline-flex;align-items:center;gap:0.4rem;font-size:0.875rem;color:var(--text-muted);margin-bottom:2rem;transition:var(--transition);" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">
        ← Back to Blog
      </a>
      <div class="post-tag">{category}</div>
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <span>🗓 {formattedDate}</span>
        <span>· {readTime}</span>
        <span>· {author}</span>
      </div>
    </div>

    <div class="post-content">
      <slot />
    </div>

    <div style="max-width:var(--content-width);margin:0 auto;padding:0 2rem 5rem;">
      <div class="newsletter" style="border-radius:var(--radius);padding:3rem;">
        <h2 style="font-size:1.8rem;margin-bottom:0.75rem;">Enjoyed this?</h2>
        <p>Get weekly insights on mindset, manifestation, and conscious living - straight to your inbox.</p>
        <form class="newsletter-form" id="newsletter-form-post">
          <input type="email" name="email" placeholder="your@email.com" required />
          <button type="submit" class="btn">Subscribe</button>
        </form>
        <p id="newsletter-msg-post" style="margin-top:1rem;font-size:0.9rem;display:none;"></p>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const form = document.getElementById('newsletter-form-post') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (form.querySelector('[name="email"]') as HTMLInputElement).value;
      const firstName = (form.querySelector('[name="firstName"]') as HTMLInputElement)?.value || '';
      const msg = document.getElementById('newsletter-msg-post')!;
      const btn = form.querySelector('button')!;
      btn.textContent = 'Subscribing...';
      btn.setAttribute('disabled', 'true');
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, firstName }),
        });
        if (res.ok) {
          msg.textContent = '🎉 You\'re in! Check your inbox to confirm.';
          msg.style.color = 'var(--sage)';
          form.reset();
        } else {
          const data = await res.json();
          msg.textContent = data.error || 'Something went wrong. Try again.';
          msg.style.color = '#e05';
        }
      } catch {
        msg.textContent = 'Something went wrong. Try again.';
        msg.style.color = '#e05';
      }
      msg.style.display = 'block';
      btn.textContent = 'Subscribe';
      btn.removeAttribute('disabled');
    });
  }
</script>
