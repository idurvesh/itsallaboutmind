---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = "Explore the power of your mind — meditation, law of attraction, mindset, and conscious living.",
  image,
  canonicalUrl,
} = Astro.props;

const canonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = 'https://itsallaboutmind.com';

const jsonLdSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "It's All About Mind",
  "url": siteUrl,
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/blog?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

  <title>{title} | It's All About Mind</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={`${title} | It's All About Mind`} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="It's All About Mind" />
  {image && <meta property="og:image" content={image.startsWith('http') ? image : `${siteUrl}${image}`} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | It's All About Mind`} />
  <meta name="twitter:description" content={description} />
  {image && <meta name="twitter:image" content={image.startsWith('http') ? image : `${siteUrl}${image}`} />}

  <!-- WebSite JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdSite)} />

  <!-- Page-level head slot (for BlogPost to inject Article schema etc.) -->
  <slot name="head" />
</head>
<body>

  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">it's all about <span>mind</span></a>
      <ul class="nav-links">
        <li><a href="/" class={Astro.url.pathname === '/' ? 'active' : ''}>Home</a></li>
        <li><a href="/blog" class={Astro.url.pathname.startsWith('/blog') ? 'active' : ''}>Blog</a></li>
        <li><a href="/resources" class={Astro.url.pathname === '/resources' ? 'active' : ''}>Resources</a></li>
        <li><a href="/about" class={Astro.url.pathname === '/about' ? 'active' : ''}>About</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <a href="/" class="footer-logo">it's all about <span>mind</span></a>
      <ul class="footer-links">
        <li><a href="/blog">Blog</a></li>
        <li><a href="/resources">Resources</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </div>
    <div class="container">
      <p class="footer-copy">© {new Date().getFullYear()} It's All About Mind · Made with intention</p>
    </div>
  </footer>

  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", (user: any) => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }

    const hash = window.location.hash;
    if (hash && (hash.includes('invite_token') || hash.includes('recovery_token') || hash.includes('confirmation_token'))) {
      window.location.href = '/admin/' + hash;
    }
  </script>

</body>
</html>
