---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  ogType?: string;
}

const {
  title,
  description = "Explore the power of your mind - meditation, law of attraction, mindset, and conscious living.",
  image,
  canonicalUrl,
  ogType = 'website',
} = Astro.props;

const canonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = 'https://itsallaboutmind.com';

const jsonLdSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "It's All About Mind",
  "url": siteUrl,
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/blog?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-TQPSZ3B6');</script>
  <!-- End Google Tag Manager -->


  <title>{title} | It's All About Mind</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={`${title} | It's All About Mind`} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="It's All About Mind" />
  {image && <meta property="og:image" content={image.startsWith('http') ? image : `${siteUrl}${image}`} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | It's All About Mind`} />
  <meta name="twitter:description" content={description} />
  {image && <meta name="twitter:image" content={image.startsWith('http') ? image : `${siteUrl}${image}`} />}

  <!-- WebSite JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdSite)} />

  <!-- Page-level head slot (for BlogPost to inject Article schema etc.) -->
  <slot name="head" />
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TQPSZ3B6"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">it's all about <span>mind</span></a>
      <ul class="nav-links">
        <li><a href="/" class={Astro.url.pathname === '/' ? 'active' : ''}>Home</a></li>
        <li><a href="/blog" class={Astro.url.pathname.startsWith('/blog') ? 'active' : ''}>Blog</a></li>
        <li><a href="/resources" class={Astro.url.pathname === '/resources' ? 'active' : ''}>Resources</a></li>
        <li><a href="/about" class={Astro.url.pathname === '/about' ? 'active' : ''}>About</a></li>
        <li><a href="/quiz" class={Astro.url.pathname.startsWith('/quiz') ? 'active' : ''} style="color:var(--accent);font-weight:500;">Quizzes</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <a href="/" class="footer-logo">it's all about <span>mind</span></a>
      <ul class="footer-links">
        <li><a href="/blog">Blog</a></li>
        <li><a href="/quiz">Quizzes</a></li>
        <li><a href="/resources">Resources</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </div>
    <div class="container">
      <p class="footer-copy">© {new Date().getFullYear()} It's All About Mind · Made with intention</p>
    </div>
  </footer>


</body>
</html>
