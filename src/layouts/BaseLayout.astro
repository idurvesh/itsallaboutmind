---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  ogType?: string;
}

const {
  title,
  description = "Explore the power of your mind - meditation, law of attraction, mindset, and conscious living.",
  image,
  canonicalUrl,
  ogType = 'website',
} = Astro.props;

const canonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = 'https://itsallaboutmind.com';

const jsonLdSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "It's All About Mind",
  "url": siteUrl,
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/blog?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
